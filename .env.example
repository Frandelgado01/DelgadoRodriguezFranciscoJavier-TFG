# Variables del entorno local. Copia este fichero a .env (ignorado por git) y cambia los valores.
# Aquí no hay secretos reales: los valores son de ejemplo para el entorno de desarrollo y el CI.

# --- Base de datos (servicio db) ---
POSTGRES_DB=cuaderno
POSTGRES_USER=cuaderno
# Cámbiala en tu .env.
POSTGRES_PASSWORD=cambia-esta-clave

# --- API ---
# URL con la que el agricultor abre la app; se usa para construir los enlaces de los correos (R9, R10).
URL_PUBLICA=https://localhost

# --- Correo (Mailpit en local; R10) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
CORREO_REMITENTE=cuaderno@localhost
