# Variables del entorno local. Copia este fichero a .env (ignorado por git) y cambia los valores.
# Aquí no hay secretos reales: los valores son de ejemplo para el entorno de desarrollo y el CI.

# --- Base de datos (servicio db) ---
POSTGRES_DB=cuaderno
POSTGRES_USER=cuaderno
# Cámbiala en tu .env.
POSTGRES_PASSWORD=cambia-esta-clave

# --- API ---
# Solo para ejecutar la API o las pruebas fuera de los contenedores; en Compose la API la construye con las
# variables POSTGRES_* y el host db.
URL_BASE_DATOS=postgresql+psycopg://cuaderno:cambia-esta-clave@127.0.0.1:5432/cuaderno
# URL con la que el agricultor abre la app; se usa para construir los enlaces de los correos (R9, R10).
URL_PUBLICA=https://localhost

# --- Correo (Mailpit en local; R10) ---
# Desde el portátil; en Compose la API usa mailpit:1025. Se usa 127.0.0.1 y no localhost porque en Windows
# localhost resuelve primero a ::1 y los puertos de Compose solo se publican en 127.0.0.1.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
CORREO_REMITENTE=cuaderno@localhost

# --- Pruebas de la API (backend/tests/conftest.py) ---
# API REST de Mailpit para leer y vaciar los correos recibidos.
URL_MAILPIT=http://127.0.0.1:8025
# Las pruebas usan una base de datos aparte: la de URL_BASE_DATOS con el sufijo _pruebas.
